{
  "name": "cypress-typescript-e2e",
  "version": "1.0.0",
  "description": "Enterprise-grade E2E and API test automation framework — Cypress, TypeScript, Page Object Model, and Newman/Postman API testing with CI/CD",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox",
    "cy:run:ui": "cypress run --spec 'cypress/e2e/ui/**/*.cy.ts'",
    "cy:run:api": "cypress run --spec 'cypress/e2e/api/**/*.cy.ts'",
    "test:api:newman": "newman run postman/jsonplaceholder.postman_collection.json -e postman/jsonplaceholder.postman_environment.json -r cli,htmlextra --reporter-htmlextra-export reports/newman/report.html",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "eslint 'cypress/**/*.ts'",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "cypress",
    "typescript",
    "e2e-testing",
    "api-testing",
    "test-automation",
    "page-object-model",
    "newman",
    "postman",
    "ci-cd"
  ],
  "author": "Eyed Friaa <eyedfriaa@yahoo.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "allure-cypress": "^3.0.0",
    "allure-commandline": "^2.30.0",
    "cypress": "^13.13.0",
    "eslint": "^8.57.0",
    "eslint-plugin-cypress": "^3.3.0",
    "newman": "^6.1.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "typescript": "^5.4.5"
  }
}
